# ─── Local CI container (optimised) ───────────────────────────────────────────
# Uses Posit Package Manager (P3M) pre-built Linux binaries → no compilation,
# first build ~7 min instead of ~47 min. Subsequent runs use cached layers.
#
# Build:       docker build -f Dockerfile.ci -t semseeker-ci .
# Check:       ./ci-local.sh
# With logs:   ./ci-local.sh logs
# Debug shell: ./ci-local.sh shell
# ───────────────────────────────────────────────────────────────────────────────

FROM rocker/r-ver:4.6

# ── Disable renv for all R processes in this container.
#    Without these, renv/activate.R (copied with the source) would intercept
#    every R startup, lock the library, and hide rcmdcheck / installed packages.
ENV RENV_CONFIG_SANDBOX_ENABLED=false
ENV RENV_ACTIVATE_PROJECT=0

# ── Required by polars installer
ENV NOT_CRAN=true

# ── R CMD check flags (mirrors what r-lib/actions/check-r-package sets in CI)
#    _R_CHECK_FORCE_SUGGESTS_=false  → don't error when Suggests are unavailable
#      (Bioconductor Suggests like pathfindR/GEOquery are not in CRAN/P3M)
#    _R_CHECK_CRAN_INCOMING_=false   → skip CRAN submission feasibility check
#      (this is an internal package, not being submitted to CRAN)
ENV _R_CHECK_FORCE_SUGGESTS_=false
ENV _R_CHECK_CRAN_INCOMING_=false

# ── System libraries (minimal — only what binary R packages still need at runtime)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libcairo2-dev \
    libfontconfig1-dev \
    libssl-dev \
    libxml2-dev \
    libcurl4-openssl-dev \
    libharfbuzz-dev \
    libfribidi-dev \
    libfreetype6-dev \
    libpng-dev \
    libtiff5-dev \
    libjpeg-dev \
    libgit2-dev \
    libsodium-dev \
    pkg-config \
    pandoc \
    && rm -rf /var/lib/apt/lists/*

# ── R repository configuration
#    P3M Ubuntu noble binaries → no compilation for CRAN packages
#    community.r-multiverse.org → polars (also ships Linux binaries)
#    Write to Rprofile.site so every Rscript invocation picks it up
RUN echo 'options(repos = c(\n\
  multiverse = "https://community.r-multiverse.org",\n\
  P3M        = "https://packagemanager.posit.co/cran/__linux__/noble/latest",\n\
  CRAN       = "https://cloud.r-project.org"\n\
))' >> /usr/local/lib/R/etc/Rprofile.site

# ── Raise the download timeout from R's 60 second default.
#    The polars installer fetches a pre-built library of about 265 MB. At the
#    default the transfer is cut mid-file and download.file() reports a length
#    mismatch rather than a timeout; the installer then falls back to building
#    from source, finds no cargo in this image, and the whole dependency layer
#    fails. Observed twice in a row, truncating at 181 MB and 192 MB after
#    1m 0.8s - the timeout, not the network.
RUN echo 'options(timeout = max(1200, getOption("timeout")))' \
  >> /usr/local/lib/R/etc/Rprofile.site

# ── Bootstrap tooling (pak for parallel installs, rcmdcheck for the check step)
RUN Rscript -e "install.packages(c('pak', 'rcmdcheck'))"

# ── Install polars ahead of pak, with install.packages().
#    There is no binary of polars for aarch64 in the repositories above, so its
#    configure script fetches a pre-built library of about 265 MB from a GitHub
#    release. That download obeys options(timeout), and pak does NOT read
#    Rprofile.site in the subprocesses it installs from, so under pak the
#    transfer is cut at the 60 second default, the installer falls back to
#    building from source, finds no cargo, and the whole dependency layer fails.
#    install.packages() does read Rprofile.site, so with the raised timeout
#    above the same download completes (measured: 111 s). pak then finds polars
#    already installed and leaves it alone.
RUN Rscript -e "install.packages('polars')"

# ── Install package dependencies
#    Layer is cached as long as DESCRIPTION doesn't change.
#    Only Imports/Depends/LinkingTo — Suggests are not needed for R CMD check
#    and pulling them (GEOquery, pathfindR, etc.) was the main source of slowness.
WORKDIR /pkg
COPY DESCRIPTION .

RUN Rscript -e "\
  pak::pak(\
    c('local::.',\
      'remotes', 'devtools', 'testthat'\
    ),\
    dependencies = c('Imports', 'Depends', 'LinkingTo'),\
    ask = FALSE\
  )"

# ── Install Bioconductor annotation packages (mirrors GitHub Actions CI).
#    Without these, .detect_tech_from_anno() returns "" and the row-count
#    heuristic mis-classifies small synthetic-probe panels — diverging from
#    real CI behaviour. Required to reproduce the Ubuntu R-CMD-check path.
RUN Rscript -e "\
  if (!requireNamespace('BiocManager', quietly = TRUE)) install.packages('BiocManager'); \
  BiocManager::install(\
    c(\
      'IlluminaHumanMethylationEPICanno.ilm10b4.hg19', \
      'IlluminaHumanMethylation450kanno.ilmn12.hg19', \
      'IlluminaHumanMethylation27kanno.ilmn12.hg19'\
    ), \
    ask = FALSE, update = FALSE\
  )"

# ── Install the Bioconductor packages the GRanges annotation backend needs.
#    Without these the whole GENE/ISLAND coordinate path skips: every test in
#    test-5-area-granges-build.R and test-5-annotation-concordance.R is guarded
#    by skip_if_not_installed(), so a local run goes green without exercising a
#    single line of it - the same silent-skip failure the meta-test
#    test-0-suggests-installed.R exists to prevent on GitHub.
#
#    org.Hs.eg.db is here for a reason of meaning, not of coverage: TxDb keys
#    genes by Entrez id, and without the symbol database the label of a gene
#    region stays that id, while the Illumina path labels with gene symbols.
#    The two backends would name the same gene two ways.
#
#    Separate layer: it is the slow and heavy one (the TxDb chain runs to about
#    a gigabyte), and keeping it apart means a change to the Illumina layer
#    above does not force it to rebuild.
RUN Rscript -e "\
  BiocManager::install(\
    c(\
      'AnnotationHub', \
      'TxDb.Hsapiens.UCSC.hg19.knownGene', \
      'org.Hs.eg.db'\
    ), \
    ask = FALSE, update = FALSE\
  )"

# ── Copy full package source (only invalidates the layer above when R code changes)
COPY . .

# ── Run R CMD check (same flags as GitHub CI)
CMD ["Rscript", "-e", "\
  rcmdcheck::rcmdcheck(\
    args       = c('--no-manual', '--as-cran'),\
    build_args = '--no-manual',\
    error_on   = 'error'\
  )"]
