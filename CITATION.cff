    given-names: Luigi
    orcid: "https://orcid.org/0000-0003-1218-230X"
version: 0.99.6
doi: 10.5281/zenodo.5095416
license: AGPL-3.0-or-later
repository-code: "https://github.com/corsaro-lab/SEMseeker"
url: "https://corsaro-lab.github.io/SEMseeker/"
keywords:
  - DNA methylation
  - epigenetics
  - stochastic epigenetic mutations
  - epigenomics
  - bioinformatics
  - R package
